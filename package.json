{
  "name": "grimms-monkeytype",
  "version": "0.1.0",
  "private": true,
  "description": "A Monkeytype-style coding typing game built with TanStack Start, React, and Bun. Live at typer.grimm0.dev.",
  "license": "MIT",
  "author": "Guilherme Grimm",
  "homepage": "https://typer.grimm0.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilherme-grimm/grimms-monkeytype.git"
  },
  "bugs": {
    "url": "https://github.com/guilherme-grimm/grimms-monkeytype/issues"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:seed:local": "bun run src/server/seed-leaderboard.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.5",
    "@libsql/client": "^0.17.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.26.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260509.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
