# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public origin used for OAuth callbacks. Set per environment.
# Local dev:  http://localhost:3000
# Production: https://typer.grimm0.dev
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth: GitHub ---
# Create at https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth: X / Twitter ---
# Create at https://developer.x.com/ (OAuth 2.0 app)
# Request scopes: users.read tweet.read offline.access user.email
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Database ---
# Path to the SQLite file. Should live on a persistent volume in production.
DATABASE_PATH=./data/app.db
